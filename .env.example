# ---------------------------------------------------------------------------
# Instagram Graph API
# ---------------------------------------------------------------------------
# A long-lived access token with insights permissions
# (instagram_basic, instagram_manage_insights, pages_read_engagement).
# Generate from https://developers.facebook.com — the account MUST be a
# Business or Creator account linked to a Facebook Page.
IG_TOKEN=your_long_lived_token_here

# Your Instagram *Business* account ID (numeric). Get it via:
#   curl "https://graph.facebook.com/v21.0/me/accounts?access_token=$IG_TOKEN"
#   then the connected instagram_business_account.id on the page.
IG_USER_ID=your_numeric_business_account_id

# Handle (used only for labelling reports).
IG_HANDLE=

# API host. Leave as-is for the Facebook Login / Graph API setup.
# Switch to https://graph.instagram.com only if you set up
# "Instagram API with Instagram Login".
IG_API_BASE=https://graph.facebook.com/v21.0

# IANA timezone used for posting-time analysis. The API returns UTC, and
# "post at 18:00" is meaningless unless it's in your audience's local time.
IG_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# Claude
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-opus-5
# Reasoning depth: low | medium | high | xhigh | max. Ignored by models that
# don't support it (the run retries without it automatically).
CLAUDE_EFFORT=high
# Covers thinking + the report itself — leave headroom or reports get truncated.
MAX_TOKENS=8000

# ---------------------------------------------------------------------------
# Using a non-Anthropic model (optional)
# ---------------------------------------------------------------------------
# Leave all of this unset to use Claude. To use any OpenAI-compatible endpoint
# instead, set the model and base URL. LLM_API_KEY falls back to
# ANTHROPIC_API_KEY when unset, so you can just reuse that field.
#
#   DeepSeek direct:  LLM_MODEL=deepseek-chat
#                     LLM_BASE_URL=https://api.deepseek.com
#   OpenRouter:       LLM_MODEL=deepseek/deepseek-chat
#                     LLM_BASE_URL=https://openrouter.ai/api/v1
#   Command Code:     LLM_MODEL=deepseek/deepseek-v4-flash
#                     LLM_BASE_URL=https://api.commandcode.ai/provider/v1
#                     (requires their Provider plan or higher — the Go plan
#                      covers the CLI agent only and returns 403 on the API)
#
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_PROVIDER=auto      # auto | anthropic | openai | cli

# --- No API access? Use a local coding-agent CLI instead ------------------
# LLM_PROVIDER=cli pipes the prompt through a CLI in non-interactive mode,
# so a CLI-only subscription works without any API entitlement. Slower than
# an API call (~90s vs ~15s) and needs the CLI logged in.
#
#   LLM_PROVIDER=cli
#   LLM_MODEL=deepseek/deepseek-v4-flash
#   LLM_CLI=cmdc          # command to invoke (default: cmdc)
#   LLM_CLI_TIMEOUT=600   # seconds before giving up

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
DAYS_LOOKBACK=30
MEDIA_LIMIT=30
HTTP_TIMEOUT=30
# Retries for throttled (429 / code 4,17,32) and 5xx Graph API responses.
HTTP_RETRIES=3

# ---------------------------------------------------------------------------
# JSON API (optional — for a mobile app or any other client)
# ---------------------------------------------------------------------------
# Served at /api/v1 by dashboard.py. Leave API_TOKEN unset and the API refuses
# every request (503) rather than serving account data unauthenticated.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# ---------------------------------------------------------------------------
# Dashboard (optional)
# ---------------------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000

# Login for the HTML dashboard (a single shared password). Leave DASHBOARD_PASSWORD
# unset and the login is DISABLED (pages are open) — set it before removing any
# proxy-level (Caddy) auth, or the dashboard becomes public.
#
# NOTE: the /admin page can override the AI token (LLM_API_KEY), model (LLM_MODEL)
# and this password at runtime. Those overrides are written to a git-ignored
# data/config.json and take precedence over the values here — no restart needed.
# config.json lives only on the box (data/ is gitignored and not deployed).
DASHBOARD_PASSWORD=
# Stable secret so sessions survive restarts. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET_KEY=
# How long a login lasts (days). Default 30.
DASHBOARD_SESSION_DAYS=30
# Cookies are marked Secure by default (HTTPS behind Caddy). Set to 0 ONLY for
# plain-http local testing, or the browser will refuse to store the session.
DASHBOARD_COOKIE_SECURE=1
